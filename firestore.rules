rules_version = '2';

// Deploy these in Firebase Console → Firestore Database → Rules (paste and Publish),
// or via the Firebase CLI: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    // Marks who is an admin. A document only exists here if YOU created it
    // by hand in the Firebase Console — no client, admin or not, can ever
    // write to this collection, so nobody can grant themselves access.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Every signed-in user has exactly one document at users/{their own uid}.
    // A normal user can update application data on their own document, but
    // subscription entitlements are immutable from the client. An admin (see
    // above) can read/write ANY user's document for support/moderation.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.get("entitlements", {}).get("trainingPro", false) == false &&
        request.resource.data.get("entitlements", {}).get("nutritionPro", false) == false;
      allow update: if request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          request.auth.uid == userId &&
          request.resource.data.get("entitlements", {}) ==
            resource.data.get("entitlements", {})
        )
      );
    }
  }
}
