{
  "appId": "com.fittrack.app",
  "appName": "Fifty Fit",
  "webDir": "dist",
  "backgroundColor": "#000000",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "force"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#000000",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000",
      "overlaysWebView": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    }
  }
}
