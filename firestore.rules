rules_version = '2';

// Deploy these in Firebase Console → Firestore Database → Rules (paste and Publish),
// or via the Firebase CLI: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get("role", "") in ["owner", "staff"];
    }

    function clientCreatedEntitlementsAreFree() {
      return request.resource.data.get("entitlements", {}) == {
        "trainingPro": false,
        "nutritionPro": false,
        "aiCoachPro": false,
        "proExpiresAt": null
      };
    }

    // Marks who is an admin. A document only exists here if the owner created
    // it deliberately. No client, admin or not, can grant itself access.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Every signed-in user has exactly one document at users/{their own uid}.
    // Normal users can update their own application data, but subscription
    // entitlements and admin-managed plans are immutable from the client.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        clientCreatedEntitlementsAreFree() &&
        !request.resource.data.keys().hasAny([
          "customTrainingPlan",
          "customNutritionPlan",
          "bothPro",
          "everythingPro",
          "adminEntitlements"
        ]);
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.get("entitlements", {}) ==
            resource.data.get("entitlements", {}) &&
          request.resource.data.get("adminEntitlements", {}) ==
            resource.data.get("adminEntitlements", {}) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "customTrainingPlan",
            "customNutritionPlan"
          ])
        )
      );
      // Required for in-app account deletion. The user can delete only their
      // own Firestore profile; authorized staff may delete any user document.
      allow delete: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
